# ---------------------------------------------------------------
# Acadverse configuration. Copy to .env and fill in the blanks.
# ---------------------------------------------------------------

# ----- MongoDB (stores student and admin accounts, papers, notes, updates) -----
# MongoDB Atlas > Connect > Drivers > copy the connection string
MONGO_URI=
# Database to use inside the cluster (created automatically)
MONGO_DB_NAME=acadverse

# ----- Cloudinary (stores uploaded PDFs and images) -----
# Cloudinary Console > Dashboard > Product Environment Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----- Authentication -----
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional "Continue with Google". Leave both blank to disable it.
# Same Google OAuth Web client ID in both places.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ----- First admin account (created by `npm run setup`) -----
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ----- Server / deployment (optional) -----
PORT=5000
# Frontend -> API base URL. Leave blank to use http://localhost:5000 in dev and same-origin /api in production.
VITE_API_URL=
# Extra comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=
